{
  "name": "libretv-custom",
  "version": "1.0.0",
  "private": true,
  "description": "LibreTV 个人定制版（基于 LibreSpark/LibreTV）",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "pack:standalone": "node scripts/pack-standalone.mjs",
    "deploy:android": "node scripts/deploy-android.mjs",
    "start": "next start -p 8080",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:client": "node tests/e2e-client-nav.cjs",
    "test:e2e:direct": "node tests/e2e-direct-nav.cjs",
    "test:e2e:filter": "node tests/e2e-content-filter.cjs",
    "test:e2e:manga": "node tests/e2e-manga.cjs",
    "test:e2e:manga-local": "node tests/e2e-manga-local.cjs",
    "test:e2e:manga-browse": "node tests/e2e-manga-browse.cjs",
    "test:e2e:manga-regions": "node tests/e2e-manga-regions.cjs",
    "test:e2e:manga-ratings": "node tests/e2e-manga-ratings.cjs",
    "test:e2e:manga-zai": "node tests/e2e-manga-zai.cjs",
    "test:e2e:rating": "node tests/e2e-rating.cjs",
    "test:e2e:lan": "node tests/e2e-lan.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.14.12",
    "adm-zip": "^0.6.1",
    "artplayer": "^5.2.3",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "hls.js": "^1.5.17",
    "mpegts.js": "^1.8.2",
    "mux.js": "^6.3.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^7.30.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.25",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hverlott/libretv.git"
  }
}
