# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：局域网访问。默认 0 = 只监听 127.0.0.1，仅本机可访问。
# 设为 1 后同网段的手机 / 电视 / 平板可用 http://本机IP:PORT 访问。
# 开启后密码是唯一防线，请确保 PASSWORD 足够强；Windows 还需放行入站端口
# （项目根目录的「放行防火墙.bat」会自动读取 PORT 并添加规则）。
# LAN_ACCESS=0
# 可选：直接指定绑定地址（优先级高于 LAN_ACCESS），如只绑某张网卡：
# BIND_HOST=192.168.31.100

# 可选：调试
DEBUG=false

# 可选：固定使用某个发布镜像版本（默认不设置 = ghcr.io/librespark/libretv:latest，
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建）
# LIBRETV_IMAGE=ghcr.io/librespark/libretv:2.0.1

# 可选：本地漫画库目录。扫描本机目录里的漫画（图片文件夹 / .cbz / .zip），
# 内容完全由使用者自己提供，系统不做任何在线抓取。留空则该板块不可用。
# LOCAL_MANGA_DIR=/path/to/your/manga

# —— 评分补全（可选）——
# 采集站条目多数没有评分。开启后会向第三方评分站查询缺失的评分。
# 注意：这会把片名发送给对方，是全站唯一对外发片名的路径，不需要就设成 none。
# auto=有 TMDB key 时用 TMDB、否则用豆瓣；tmdb / douban=只用指定源；none=关闭
# RATING_PROVIDER=auto
# TMDB API key（免费申请：https://www.themoviedb.org/settings/api）
# 配置了就走官方 API（50 次/秒）；不配则自动降级到豆瓣（免 key，但反爬严、需低频）
# TMDB_API_KEY=
# 默认 api.tmdb.org——api.themoviedb.org 在部分网络环境被 DNS 污染，直连不通
# TMDB_API_BASE=https://api.tmdb.org
# 单独关掉豆瓣（1=开 / 0=关）
# RATING_DOUBAN=1
# 评分缓存有效期（天）
# RATING_TTL_DAYS=30
# 评分缓存落盘（1=开 / 0=只内存）。落盘键为 HMAC，不含明文片名
# RATING_PERSIST=1
